  private flashEnemySprite(sprite: Phaser.GameObjects.Sprite): void {
    scene.tweens.add({ targets: sprite, tint: 0xff0000, duration: 100, yoyo: true });
  }

  private flashPlayer(): void {
    scene.cameras.main.flash(200, 255, 0, 0);
  }

  private notifyGameScene(result: string, index: number): void {
    const gs = scene.scene.get('GameScene') as any;
    if (gs && gs.onBattleEnd && scene.enemyRefs[index]) {
      gs.onBattleEnd(result, scene.enemyRefs[index]);
    }
  }

  private clearCommands(): void {
    if (scene.commandContainer) { scene.commandContainer.destroy(); scene.commandContainer = null; }
    // ★ 清理上一轮残留的键盘快捷键监听器，防止累积
    scene.shortcutKeys.forEach(k => k.off('down'));
    scene.shortcutKeys = [];
  }

  private clearSubMenu(): void {
    if (scene.subMenuContainer) { scene.subMenuContainer.destroy(); scene.subMenuContainer = null; }
  }
  update(): void {
    scene.drawAllEnemyHp();
    scene.drawPlayerBars();
    scene.tickFloat();
  }
  /** HP 差值检测 → 统一触发伤害/治疗飘字（覆盖攻击/鬼道/状态tick/道具等所有变动） */
  private _prevPlayerHp?: number;
  private _prevEnemyHp: number[] = [];

  private tickFloat(): void {
    if (scene._prevPlayerHp === undefined) scene._prevPlayerHp = scene.playerHp;
    const pd = scene.playerHp - scene._prevPlayerHp;
    if (Math.abs(pd) >= 1) {
      floatDamage(this, GAME_WIDTH * 0.24, GAME_HEIGHT * 0.22 - 70, Math.round(pd), pd < 0 ? 'dmg' : 'heal', { big: Math.abs(pd) > 200 });
      scene._prevPlayerHp = scene.playerHp;
    }
    if (scene._prevEnemyHp.length !== scene.enemies.length) {
      scene._prevEnemyHp = scene.enemies.map((e) => e.hp);
    }
    scene.enemies.forEach((en, i) => {
      const prev = scene._prevEnemyHp[i];
      if (prev === undefined) { scene._prevEnemyHp[i] = en.hp; return; }
      const d = en.hp - prev;
      if (Math.abs(d) >= 1) {
        const sp = scene.enemySprites[i];
        const x = sp ? sp.x : GAME_WIDTH / 2;
        const y = sp ? sp.y - 60 : GAME_HEIGHT / 2;
        floatDamage(this, x, y, Math.round(d), d < 0 ? 'dmg' : 'heal', { big: Math.abs(d) > 200 });
        scene._prevEnemyHp[i] = en.hp;
      }
    });
  }
  /** 创建一个状态图标槽（PNG 图标 + 右下角回合数） */

  private makeStatusSlot(): StatusSlot {
    return {
      img: scene.add.image(0, 0, 'icon_burn').setVisible(false).setDepth(300),
      txt: scene.add.text(0, 0, '', {
        fontSize: '11px', color: '#ffffff', fontStyle: 'bold',
        stroke: '#000000', strokeThickness: 3,
      }).setOrigin(1, 1).setVisible(false).setDepth(301),
    };
  }
  /** 创建一排状态图标槽（容量 = 同时可能出现的最大状态数） */

  private makeStatusSlotRow(): StatusSlot[] {
    return Array.from({ length: 13 }, () => scene.makeStatusSlot());
  }
  /**
   * 将激活状态列表布局为一行居中图标，超出部分自动隐藏。
   * 图标尺寸 slot，间距 2px；右下角显示剩余回合数。
   */

  private layoutStatusIcons(slots: StatusSlot[], active: ActiveStatusEntry[], centerX: number, centerY: number, slot: number): void {
    const gap = 2;
    const n = active.length;
    const totalW = n * slot + Math.max(0, n - 1) * gap;
    let x = centerX - totalW / 2 + slot / 2;
    for (let i = 0; i < slots.length; i++) {
      const s = slots[i];
      if (i < n) {
        const a = active[i];
        if (scene.textures.exists(a.texture)) {
          s.img.setTexture(a.texture).setVisible(true).setPosition(x, centerY).setDisplaySize(slot, slot);
          s.txt.setOrigin(0).setVisible(true).setPosition(x + slot / 2 - 1, centerY + slot / 2 - 1).setText(String(a.turns));
        } else {
          // 纹理缺失兜底：显示中文名，保证状态可见（对齐 MultiBattleScene.drawStatusIcons）
          s.img.setVisible(false);
          s.txt.setOrigin(0.5).setVisible(true).setPosition(x, centerY).setText(a.name);
        }
        x += slot + gap;
      } else {
        s.img.setVisible(false);
        s.txt.setVisible(false);
      }
    }
  }

  private drawAllEnemyHp(): void {
    const positions = scene.getEnemyPositions(scene.enemies.length);
    const count = scene.enemies.length;
    scene.enemyHpBars.forEach((bar, i) => {
      const info = scene.enemyInfoTexts[i];
      const slots = scene.enemyStatusSlots[i];
      const enemy = scene.enemies[i];
      if (!enemy || enemy.hp <= 0) {
        if (info) info.setText('');
        if (slots) slots.forEach(s => { s.img.setVisible(false); s.txt.setVisible(false); });
        bar.setVisible(false);
        return;
      }
      const pos = positions[i];
      const bw = count <= 4 ? 100 : 70, bh = 7;
      const bx = pos.x - bw / 2, by = pos.y + 40;   // 血条置于精灵下方，避免遮挡
      const ratio = Math.max(0, enemy.hp / enemy.maxHp);
      const color = ratio > 0.5 ? 0xcc4444 : ratio > 0.25 ? 0xcc8844 : 0xcc2222;
      bar.setPosition(bx, by);
      bar.setRatio(ratio, color);
      if (info) {
        const active = getActiveStatusList(scene.enemyStatuses[i]);
        info.setPosition(pos.x, by + bh + 3);
        info.setText(`${enemy.hp}/${enemy.maxHp}`);
        scene.layoutStatusIcons(slots, active, pos.x, pos.y + 80, 22);
      }
    });
  }

  private drawPlayerBars(): void {
    const by = GAME_HEIGHT * 0.22 + 170, bw = 180;
    const hpRatio = scene.playerHp / scene.playerMaxHp;
    scene.playerHpBar.setRatio(hpRatio, hpColor(hpRatio));
    const mpRatio = scene.playerMp / scene.playerMaxMp;
    scene.playerMpBar.setRatio(mpRatio, 0x4444cc);
    const active = getActiveStatusList(scene.playerStatus);
    scene.playerInfoText.setText(
      `HP ${Math.ceil(scene.playerHp)}/${scene.playerMaxHp}   MP ${Math.ceil(scene.playerMp)}/${scene.playerMaxMp}`
    );
    scene.layoutStatusIcons(scene.playerStatusSlots, active, GAME_WIDTH * 0.24, by + 56, 22);
